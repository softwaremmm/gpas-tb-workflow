
process {
    withLabel: clockwork {
        container = 'lhr.ocir.io/lrbvkel2wjot/oxfordmmm/clockwork:latest'
    }
}

profiles {
    local {
        process {
            executor = 'local'
        }
        docker.enabled = true
    }

    mini {
        process {
            executor = 'k8s'
        }
        k8s {
            workDir = '/workspace'
            namespace        = 'default'

            serviceAccount   = 'default'
            computeResourceType = 'Job'
            storageClaimName = 'standard'
            storageMountPath = '/workspace'
      }
    }

    kubernetes {
        process {
            executor = 'k8s'
        }
        k8s {
            workDir = '/workspace'
            namespace        = 'default'

            serviceAccount   = 'nextflow-bot'
            computeResourceType = 'Job'
            storageClaimName = 'nextflow-fss-claim'
            storageMountPath = '/workspace'
      }
    }

}
