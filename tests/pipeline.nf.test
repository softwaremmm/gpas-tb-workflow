nextflow_pipeline {

    name "Test TB pipeline"
    script "../main.nf"

    test("Pipeline should succeeded and execute all subworflows if sample is TB") {
        tag "full"
        tag "tb"

        when {
            params {
              sample_id = 1
              run_id  = 1
              updir = "/mnt/volume_data/work_packages/data/h37rv_tb/1/"
              indir = "/mnt/volume_data/work_packages/data/h37rv_tb/1/1"
              outdir = "/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1"
              outdir = "/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1"
              uploads_bucket = "/mnt/volume_data/work_packages/data/h37rv_tb/"
              inputs_bucket = "/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/"
              outputs_bucket = "/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output"
              outputs_bucket = "/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output"
              api_token = ""
              api_url = "https://dev.portal.gpas.world"
              species = 'test'
              kraken2_db_path = "/mnt/volume_data/datasets_full/standard_05-06-2023"
              human_genome_dir = "/mnt/volume_data/work_packages/data/human_genome/"
              manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
              ref_files = "/mnt/volume_data/work_packages/data/clockwork/tb/Ref_prepare"
              tb_ref_genome = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3.gbk"
              tb_amr_cat = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3_WHO-UCN-GTB-PCI-2021.7_v1.0_GARC1_RUS.csv"
              tb_minor_alleles = "/mnt/volume_data/work_packages/data/minor_alleles.txt"
            }

        }

        then {

            assert workflow.success

            // Assert number of files copied to inputs_bucket_local
            // assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/1/1/").list().size() == 2


            // DECONTAMINATION
            // Copy decontaminated files to the uploads_bucket location
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/1/1/1.clean_1.fastq.gz").linesGzip.size() >= 1
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/1/1/1.clean_2.fastq.gz").linesGzip.size() >= 1



            // GATEKEEPER
            // Samples has enough Unclassified and Mycrobacteriae reads
            assert workflow.stdout.contains("Gatekeeper output sample has enough reads")

            // Pipeline stores Gatekeeper FASTP related files
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/read_preprocessing_report.json").readLines().size() >= 0
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/read_preprocessing_error.json").readLines().size() == 0

            // Pipeline stores json Gatekeeper Kraken2 with empty list of errors
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/speciation_error.json").readLines()[0] == '[]'
            
             // Pipeline stores gatekeeper report
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/speciation_report.json").readLines().size() >= 0


            // COMPETITIVE MAPPING
            // Samples has enough  h37rv_tb reads
            assert workflow.stdout.contains("Competitive Mapping output sample has enough reads")

            // Pipeline stores Competitive Mapping report file
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/species_comparison_report.json").readLines().size() >= 1

            // CLOCKWORK
            //Pipeline stored all clockwork related files in a tb named folder
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/tb/").list().size() == 11


            // RESISTANCE PREDICTION
            //Pipeline stored all clockwork related files in a tb named folder
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/tb/resistance_prediction_report.json").readLines().size() >= 1

            // FN5
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/tb/error_log").readLines().size() >= 0

        }

    }

}
