nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    test("Should stop run if Competitive Mapping returns false to enough number of reads") {

        when {
            params {
              sample_id = 1
              run_id  = 1
              api_token = "token"
              uploads_bucket = "samples/local/tb/"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 2
        }

    }

}
