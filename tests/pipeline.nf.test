nextflow_pipeline {

    name "Test TB pipeline"
    script "../main.nf"

    test("Gatekeeper: logs should inform if Gatekeeper returns TRUE to enough number of reads") {

        when {
            params {
              sample_id = 1
              run_id  = 1
              updir = "/mnt/volume_data/work_packages/data/h37rv_tb/1"
              indir = "/mnt/volume_data/work_packages/data/h37rv_tb/1"
              uploads_bucket = "/mnt/volume_data/work_packages/data/h37rv_tb/"
              api_token = "token"
              kraken2_db_path = "/mnt/volume_data/datasets_full/standard_05-06-2023"
              human_genome_dir = "/mnt/volume_data/work_packages/data/human_genome/"
              manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
              ref_files = "/mnt/volume_data/work_packages/data/clockwork/tb/Ref_prepare"
              tb_ref_genome = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3.gbk"
              tb_amr_cat = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3_WHO-UCN-GTB-PCI-2021.7_v1.0_GARC1_RUS.csv"
              tb_minor_alleles = "/mnt/volume_data/work_packages/data/minor_alleles.txt"

            }

        }

        then {

            assert workflow.success

            //returns a list containing succeeded tasks
            assert workflow.trace.succeeded().size() == 7

            //returns a list containing failed tasks
            assert workflow.trace.failed().size() == 0

            //returns a list containing all tasks
            assert workflow.trace.tasks().size() == 7


            assert workflow.stdout.contains("Gatekeeper output sample has enough reads")


        }

    }

    test("Gatekeeper: logs should inform if Gatekeeper returns FALSE to enough number of reads") {

        when {
            params {
              sample_id = 1
              run_id  = 1
              updir = "/mnt/volume_data/work_packages/data/virus/1"
              indir = "/mnt/volume_data/work_packages/data/virus/1"
              uploads_bucket = "/mnt/volume_data/work_packages/data/virus/"
              kraken2_db_path = "/mnt/volume_data/datasets_full/standard_05-06-2023"
              human_genome_dir = "/mnt/volume_data/work_packages/data/human_genome/"
              manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
              ref_files = "/mnt/volume_data/work_packages/data/clockwork/tb/Ref_prepare"
              tb_ref_genome = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3.gbk"
              tb_amr_cat = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3_WHO-UCN-GTB-PCI-2021.7_v1.0_GARC1_RUS.csv"
              tb_minor_alleles = "/mnt/volume_data/work_packages/data/minor_alleles.txt"
            }

        }

        then {

            assert workflow.success

            //returns a list containing succeeded tasks
            assert workflow.trace.succeeded().size() == 5

            //returns a list containing failed tasks
            assert workflow.trace.failed().size() == 0

            //returns a list containing all tasks
            assert workflow.trace.tasks().size() == 5


            assert workflow.stdout.contains("Gatekeeper output sample does not have enough reads. END OF THE PIPELINE")
        }

    }

    test("Competitive Mapping: logs should inform if Competitive Mapping returns TRUE to enough number of reads") {

        when {
            params {
              sample_id = 1
              run_id  = 1
              updir = "/mnt/volume_data/work_packages/data/h37rv_tb/1"
              indir = "/mnt/volume_data/work_packages/data/h37rv_tb/1"
              uploads_bucket = "/mnt/volume_data/work_packages/data/h37rv_tb/"
              api_token = "token"
              kraken2_db_path = "/mnt/volume_data/datasets_full/standard_05-06-2023"
              human_genome_dir = "/mnt/volume_data/work_packages/data/human_genome/"
              manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
              ref_files = "/mnt/volume_data/work_packages/data/clockwork/tb/Ref_prepare"
              tb_ref_genome = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3.gbk"
              tb_amr_cat = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3_WHO-UCN-GTB-PCI-2021.7_v1.0_GARC1_RUS.csv"
              tb_minor_alleles = "/mnt/volume_data/work_packages/data/minor_alleles.txt"
            }

        }

        then {

            assert workflow.success

            //returns a list containing succeeded tasks
            assert workflow.trace.succeeded().size() == 7

            //returns a list containing failed tasks
            assert workflow.trace.failed().size() == 0

            //returns a list containing all tasks
            assert workflow.trace.tasks().size() == 7


            assert workflow.stdout.contains("Competitive Mapping output sample has enough reads")
        }

    }

    test("Competitive Mapping: logs should inform if Competitive Mapping returns FALSE to enough number of reads") {

        when {
            params {
              sample_id = 1
              run_id  = 1
              updir = "/mnt/volume_data/work_packages/data/abscessus/1"
              indir = "/mnt/volume_data/work_packages/data/abscessus/1"
              uploads_bucket = "/mnt/volume_data/work_packages/data/abscessus/"
              api_token = "token"
              kraken2_db_path = "/mnt/volume_data/datasets_full/standard_05-06-2023"
              human_genome_dir = "/mnt/volume_data/work_packages/data/human_genome/"
              manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
              ref_files = "/mnt/volume_data/work_packages/data/clockwork/tb/Ref_prepare"
              tb_ref_genome = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3.gbk"
              tb_amr_cat = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3_WHO-UCN-GTB-PCI-2021.7_v1.0_GARC1_RUS.csv"
              tb_minor_alleles = "/mnt/volume_data/work_packages/data/minor_alleles.txt"
            }

        }

        then {

            assert workflow.success

            //returns a list containing succeeded tasks
            assert workflow.trace.succeeded().size() == 7

            //returns a list containing failed tasks
            assert workflow.trace.failed().size() == 0

            //returns a list containing all tasks
            assert workflow.trace.tasks().size() == 7

            assert workflow.stdout.contains("Competitive Mapping output sample does not have enough reads. END OF THE PIPELINE")
        }

    }

    test("Pipeline should succeeded and execute all subworflows if sample is TB") {
        tag "full"
        tag "tb"

        when {
            params {
              sample_id = 1
              run_id  = 1
              updir = "/mnt/volume_data/work_packages/data/h37rv_tb/1/"
              indir = "/mnt/volume_data/work_packages/data/h37rv_tb/1/1"
              outdir = "/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1"
              uploads_bucket = "/mnt/volume_data/work_packages/data/h37rv_tb/"
              inputs_bucket = "/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/"
              outputs_bucket = "/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output"
              api_token = "token"
              kraken2_db_path = "/mnt/volume_data/datasets_full/standard_05-06-2023"
              human_genome_dir = "/mnt/volume_data/work_packages/data/human_genome/"
              manifest = "/mnt/volume_data/work_packages/data/manifest/target_101_new.fasta"
              ref_files = "/mnt/volume_data/work_packages/data/clockwork/tb/Ref_prepare"
              tb_ref_genome = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3.gbk"
              tb_amr_cat = "/mnt/volume_data/work_packages/wp6/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3_WHO-UCN-GTB-PCI-2021.7_v1.0_GARC1_RUS.csv"
              tb_minor_alleles = "/mnt/volume_data/work_packages/data/minor_alleles.txt"
            }

        }

        then {

            assert workflow.success

            // Assert number of files copied to inputs_bucket_local
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/1/1/").list().size() == 2


            // DECONTAMINATION

            // Copy decontaminated files to the uploads_bucket location 
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/1/1/WTCHG_885333_73205296_1.clean_1.fastq.gz").linesGzip.size() >= 1
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/1/1/WTCHG_885333_73205296_2.clean_2.fastq.gz").linesGzip.size() >= 1
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/decontamination-log.json").readLines().size() >= 0
            
            // GATEKEEPER 

            // Samples has enough Unclassified and Mycrobacteriae reads 
            assert workflow.stdout.contains("Gatekeeper output sample has enough reads")

            // Gatekeeper return FASTP related files
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/fastp_report.json").readLines().size() >= 0
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/fastp_error.json").readLines().size() == 0

            //Gatekeeper return json with empty list of errors
            assert path("/mnt/volume_data/work_packages/data/inputs_bucket_local/h37rv_tb/output/1/1/kraken_error.json").readLines()[0] == '[]'


        }

    }
    



}
