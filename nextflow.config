
trace {
   enabled = true
   file = 'trace.txt'
   overwrite = true
   fields = 'task_id,hash,native_id,name,status,exit,submit,duration,%cpu,rss,vmem,rchar,wchar,attempt,env,hostname'   
}

params {
   testing = ''
}

profiles {
    local {
        process {
            executor = 'local'
        }
        docker.enabled = true
        env.WORKSPACE = 'offline'
    }

    mini {
        process {
            executor = 'k8s'
        }
        k8s {
            workDir = '/workspace'
            namespace        = 'default'

            serviceAccount   = 'default'
            computeResourceType = 'Job'
            storageClaimName = 'standard'
            storageMountPath = '/workspace'
      }
    }

    kubernetes {
        process {
            executor = 'k8s'
            container = 'lhr.ocir.io/lrbvkel2wjot/gpas/pipeline-utils:v0.0.2'
            maxRetries = 4
            errorStrategy = {
                sleep(60 * Math.pow(2, task.attempt) as long)
                task.attempt<=maxRetries ? 'retry' : 'terminate'
            }
            resourceLimits = [
              cpus: 8,
              time: 3.h
            ]
        }
        k8s {
            workDir = '/workspace'
            namespace        = 'default'

            serviceAccount   = 'nextflow-bot'
            computeResourceType = 'Job'
            storageClaimName = 'nextflow-fss-claim'
            storageMountPath = '/workspace'
            launchDir = '/workspace/runs'
            projectDir = '/workspace/project'
            pod = [
                [privileged: true],
                [secret: 'nextflow-api-key-secret', mountPath: '/etc/nextflow-api-key'],
                [env: 'S3FS_FROM_NEXTFLOW', secret: 's3fs-password-secret/s3fs_password_file'],
                [imagePullSecret: 'ocir-pull-image-secret']
            ]
            fetchNodeName = true
            maxErrorRetry = 4
      }
    }

}
