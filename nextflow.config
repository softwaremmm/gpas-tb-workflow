
trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,%cpu,rss,vmem,rchar,wchar,attempt,env,hostname'
}
report {
    overwrite = true
}

profiles {
    local {
        params {
            uploads_bucket = "$projectDir/data/uploads"
            inputs_bucket = "$projectDir/data/inputs"
            outputs_bucket = "$projectDir/data/outputs"
            relatedness_bucket = "$projectDir/data/relatedness"
            knowledge_bucket = "$projectDir/data/knowledge"
            kraken2_db_path = "$params.knowledge_bucket/kraken2_db"
        }
        process {
            executor = 'local'
        }
        docker.enabled = true
        env.WORKSPACE = 'offline'
    }

    mini {
        process {
            executor = 'k8s'
        }
        k8s {
            workDir = '/workspace'
            namespace        = 'default'

            serviceAccount   = 'default'
            computeResourceType = 'Job'
            storageClaimName = 'standard'
            storageMountPath = '/workspace'
        }
    }

    kubernetes {
        params {
            uploads_bucket = '/workspace/buckets/upload_bucket'
            inputs_bucket = '/workspace/buckets/input_bucket'
            outputs_bucket = '/workspace/buckets/output_bucket'
            relatedness_bucket = '/workspace/buckets/relatedness_bucket'
            knowledge_bucket = '/workspace/buckets/knowledge'
            kraken2_db_path = "/dev/shm/kraken2_db"
        }
        process {
            executor = 'k8s'
            container = 'lhr.ocir.io/lrbvkel2wjot/gpas/pipeline-utils:v0.0.2'
            maxRetries = 4
            errorStrategy = {
                sleep(60 * Math.pow(2, task.attempt) as long)
                task.attempt <= maxRetries ? 'retry' : 'terminate'
            }
            resourceLimits = [
              cpus: 8,
              time: 3.h
            ]
        }
        k8s {
            workDir = '/workspace'
            namespace        = 'default'

            serviceAccount   = 'nextflow-bot'
            computeResourceType = 'Job'
            storageClaimName = 'nextflow-fss-claim'
            storageMountPath = '/workspace'
            launchDir = '/workspace/runs'
            projectDir = '/workspace/project'
            pod = [
                [privileged: true],
                [secret: 'nextflow-api-key-secret', mountPath: '/etc/nextflow-api-key'],
                [imagePullSecret: 'ocir-pull-image-secret'],
                [hostPath: '/buckets', mountPath: '/workspace/buckets'],
                [annotation: 'cluster-autoscaler.kubernetes.io/safe-to-evict', value: 'false'],
                [
                    affinity: [
                        podAffinity: [
                            requiredDuringSchedulingIgnoredDuringExecution: [[
                                labelSelector:
                                    [matchExpressions: [
                                        [key: 'mounter-ready', operator: 'In', values: ['true']]
                                ]],
                                topologyKey: 'kubernetes.io/hostname'
                            ]]
                        ]
                    ]
                ]
            ]
            fetchNodeName = true
            maxErrorRetry = 4
        }
    }

    no_fn5 {
        params.run_fn5 = "false"
    }
}

params {
    // **Defaults**
    api_url = 'https://dev.portal.gpas.world'
    species = 'tb'
    // Testing and test_container must be set to empty strings, or parts of the pipeline
    // will run in "test mode" - with less resources or the wrong container.
    testing = ''
    test_container = ''
    params.mem_map = "false" // gatekeeper will still use memory mapping if the profile is kubernetes
    params.publish = false
    params.run_fn5 = "true"
    api_token = ''

    // **Reference data**

    // Human read removal
    human_genome_dir = "$params.knowledge_bucket/human-genome"

    // Competitive mapping
    manifest = "$params.knowledge_bucket/manifest/manifest_20231001"
    species_list = "$params.knowledge_bucket/manifest/species_list_manifest_20240710.csv"
    name_mapping = "$params.knowledge_bucket/manifest/competitive_mapping_mykrobe_names_20240715.csv"

    // Genome assembly
    ref_files = "$params.knowledge_bucket/clockwork/tb/Ref_prepare"
    sundial_ref = "$params.knowledge_bucket/sundial/h37rv_20231215.fa.gz"
    sundial_mask = "$params.knowledge_bucket/sundial/compass-mask_20231215.bed"

    // Resistance prediction
    tb_ref_genome = "$params.knowledge_bucket/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3.gbk"
    tb_amr_cat = "$params.knowledge_bucket/tuberculosis_amr_catalogues/catalogues/NC_000962.3/NC_000962.3_WHO-UCN-TB-2023.5_v2.0_GARC1_RFUS.csv"
    null_positions = "$params.knowledge_bucket/null_positions.txt"
    tb_minor_alleles = "$params.knowledge_bucket/minor_alleles.txt"

    // FN5
    tb_ref = "$params.knowledge_bucket/tb/NC_000962.3.fasta"
    tb_mask = "$params.knowledge_bucket/tb/tb-exclude.txt"
}
