trace {
    enabled = true
    sep = ','
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,%cpu,rss,vmem,rchar,wchar,attempt,env,hostname'
}
report {
    overwrite = true
}


profiles {
    local {
        manifest.nextflowVersion = '24.10.4'
        params {
            sample_id = "LOCAL"
            run_id = ""
            run_fn6 = "false"
            uploads_bucket = "${projectDir}/data/uploads"
            inputs_bucket = "${projectDir}/data/inputs"
            outputs_bucket = "${projectDir}/data/outputs"
            relatedness_bucket = "${projectDir}/data/relatedness"
            knowledge_bucket = "${projectDir}/data/knowledge"
            relatedness_pvc_saves = '${projectDir}/data/dummy-pvc/relatedness-saves'
            kraken2_db_path = "${params.knowledge_bucket}/kraken2_db"
            container_prefix = "lhr.ocir.io/lrbvkel2wjot"
        }
        process {
            debug = false
            executor = 'local'
            maxRetries = 4
            errorStrategy = {
                sleep(10)
                return 'retry'
            }
        }
        docker.enabled = true
        env.WORKSPACE = 'offline'
    }

    mini {
        process {
            executor = 'k8s'
        }
        k8s {
            workDir = '/workspace'
            namespace = 'default'

            serviceAccount = 'default'
            computeResourceType = 'Job'
            storageClaimName = 'standard'
            storageMountPath = '/workspace'
        }
    }

    kubernetes {
        params {
            uploads_bucket = '/workspace/buckets/upload_bucket'
            inputs_bucket = '/workspace/buckets/input_bucket'
            outputs_bucket = '/workspace/buckets/output_bucket'
            relatedness_bucket = '/workspace/buckets/relatedness_bucket'
            knowledge_bucket = '/workspace/buckets/knowledge'
            relatedness_pvc_saves = '/workspace/relatedness-saves'
            kraken2_db_path = "/dev/shm/kraken2_db"
            container_prefix = "lhr.ocir.io/lrbvkel2wjot"
        }
        process {
            debug = true
            executor = 'k8s'
            container = 'lhr.ocir.io/lrbvkel2wjot/gpas/pipeline-utils:v0.0.2'
            maxRetries = 4
            errorStrategy = {
                sleep(60 * Math.pow(2, task.attempt) as Integer)
                return 'retry'
            }
            resourceLimits = [
                cpus: 8,
                time: 3.h,
            ]
        }
        k8s {
            workDir = '/workspace'
            namespace = 'default'

            serviceAccount = 'nextflow-bot'
            computeResourceType = 'Job'
            storageClaimName = 'nextflow-fss-claim'
            storageMountPath = '/workspace'
            launchDir = '/workspace/runs'
            projectDir = '/workspace/project'
            pod = [
                [privileged: true],
                [secret: 'nextflow-api-key-secret', mountPath: '/etc/nextflow-api-key'],
                [imagePullSecret: 'ocirsecret'],
                [hostPath: '/buckets', mountPath: '/workspace/buckets'],
                [annotation: 'cluster-autoscaler.kubernetes.io/safe-to-evict', value: 'false'],
                [
                    affinity: [
                        podAffinity: [
                            requiredDuringSchedulingIgnoredDuringExecution: [
                                [
                                    labelSelector: [
                                        matchExpressions: [
                                            [key: 'mounter-ready', operator: 'In', values: ['true']]
                                        ]
                                    ],
                                    topologyKey: 'kubernetes.io/hostname',
                                ]
                            ]
                        ],
                        nodeAffinity: [
                            requiredDuringSchedulingIgnoredDuringExecution: [
                                nodeSelectorTerms: [
                                    [
                                        matchExpressions: [
                                            [key: 'oke.oraclecloud.com/pool.name', operator: 'In', values: ['autoscaler_pool', 'temp_pool']]

                                        ]
                                    ]
                                ]
                            ]
                        ],
                    ]
                ],
            ]
            fetchNodeName = true
            maxErrorRetry = 4
            debug.yaml = true
        }
    }
}

params {
    // **Defaults**
    api_url = 'https://dev.portal.gpas.world'
    species = 'tb'
    relatedness_species = 'tb_masquerade'
    reference_name = 'M.tuberculosis'
    // Testing and test_container must be set to empty strings, or parts of the pipeline
    // will run in "test mode" - with less resources or the wrong container.
    testing = ''
    test_container = ''
    mem_map = "false"
    // gatekeeper will still use memory mapping if the profile is kubernetes
    publish_dir = ''
    run_fn6 = "true"
    api_token = ''

    // **Reference data**

    // Human read removal
    human_genome_dir = "${params.knowledge_bucket}/human-genome"

    // Competitive mapping
    manifest = "${params.knowledge_bucket}/manifest/manifest_20231001"
    species_list = "${params.knowledge_bucket}/manifest/species_list_manifest_20250324.csv"
    name_mapping = "${params.knowledge_bucket}/manifest/competitive_mapping_mykrobe_names_20241105.csv"

    sylph_dbs = [
        "${params.knowledge_bucket}/sylph/myco_gtdb/myco_gtdb.syldb"
    ]
    ref_genome_dirs = [
        "${params.knowledge_bucket}/sylph/myco_gtdb/"
    ]
    taxonomy_files = [
        "${params.knowledge_bucket}/sylph/myco_gtdb/taxonomy.tsv"
    ]
    fixed_refs = "GCF_000195955.2"
    ref_for_fastqs = "Mycobacterium_tuberculosis,Mycobacterium_abscessus,Mycobacterium_chelonae,Mycobacterium_fortuitum,Mycobacterium_kansasii,Mycobacterium_avium,Mycobacterium_chimaera,Mycobacterium_intracellulare"

    // Genome assembly
    reference_genomes_dir = "${params.knowledge_bucket}/reference_genomes"
    tb_ref_dir = "${reference_genomes_dir}/Mycobacterium_tuberculosis"
    clair3_model_dir = "${params.knowledge_bucket}/rundial/clair3_models/"
    basecalling_model = "none_provided"

    // The follow params are just used for reporting in the gather knowledge step
    // The files are actually just copied from tb_ref_dir
    clockwork_ref = "${tb_ref_dir}/clockwork"
    rundial_ref = "${tb_ref_dir}/NC_000962.3.fasta.gz"
    tb_ref_genome = "${tb_ref_dir}/NC_000962.3.gbk"
    tb_amr_cat = "${tb_ref_dir}/NC_000962.3_WHO-UCN-TB-2023.5_v2.1_GARC1_RFUS.csv"
    null_positions = "${tb_ref_dir}/null_positions.txt"

    // FN6
    tb_ref = "${params.knowledge_bucket}/tb/NC_000962.3.fasta"
    tb_mask = "${params.knowledge_bucket}/tb/masquerade_std_tb_plus.mask"

    // **Container overrides**
    // This enables testing subworkflow branches which may not have releases yet
    test_container_cm = ""
    test_container_gatekeeper = ""
    test_container_myco_summary = ""
    test_container_rundial = ""
}
