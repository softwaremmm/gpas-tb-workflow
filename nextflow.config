customPath = "./bin:$PATH"

profiles {
    local {
        process {
            executor = 'local'
            cpus = 6
            memory = "16GB"
            container = "lhr.ocir.io/lrbvkel2wjot/oxfordmmm/fn5:latest"
        }
        docker {
            enabled = true
            runOptions = "-u \$(id -u):\$(id -g) --network host"
            registry = "lhr.ocir.io"
        }
        fixOwnership = true
    }

    mini {
        process {
            executor = "k8s"
        }
        k8s {
            workDir = "/workspace"
            namespace        = 'default'

            serviceAccount   = 'default'
            computeResourceType = 'Job'
            storageClaimName = 'standard'
            storageMountPath = '/workspace'
      }
    }

    kubernetes {
        process {
            executor = "k8s"
        }
        k8s {
            workDir = "/workspace"
            namespace        = 'default'

            serviceAccount   = 'nextflow-bot'
            computeResourceType = 'Job'
            storageClaimName = 'nextflow-fss-claim'
            storageMountPath = '/workspace'
      }
    }

}