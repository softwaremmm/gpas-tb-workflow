customPath = "./bin:$PATH"

if ("$EXECUTOR" != 'k8s') {
  executor = "local"
  workDir = "./workspace"
} else {
  executor = "k8s"
  workDir = "/workspace"
}


process {
   executor = executor
}

params {
  help = ''
  species = 'tb'
  api_url = 'http://host.docker.internal:8000'
  params.sample_id = 1
  params.run_id = 1
}

profiles {
    kubernetes {}
    docker {
        process.executer = 'local'
        docker.enabled = true
        fixOwnership = true
        docker.runOptions = "-u \$(id -u):\$(id -g) --network host"
        process.cpus = 6
        process.memory = "16GB"
        docker.registry = "lhr.ocir.io"
        process.container = "lhr.ocir.io/lrbvkel2wjot/oxfordmmm/fn5:latest"
    }
}