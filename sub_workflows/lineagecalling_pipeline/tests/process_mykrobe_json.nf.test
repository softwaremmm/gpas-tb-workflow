nextflow_process {
    name 'Test Process mykrobe_json'
    script 'main.nf'
    process 'mykrobe_json'

    test('Regression test against expected outputs (absc_100k)') {
        when {
            process {
                """
                // Inputs of process
                input[0] = ['absc_100k', file("test_data/absc_100k/absc_100k_1.fastq.gz"), file("test_data/absc_100k/absc_100k_2.fastq.gz")]
                input[1] = file('test_data/example_output/absc_100k_lc_report.json')
                """
            }
        }

        then {
            // Check process has run OK
            assert process.success
            // Check outputs are right
            assert process.out.mykrobe_report.get(0).contains('absc_100k_mykrobe_report.json')
            assert path(process.out.mykrobe_report.get(0)).json == path('./test_data/example_output/absc_100k_mykrobe_report.json').json
        }
    }

    test('Regression test against expected outputs (h37rv_100k)') {
        when {
            process {
                """
                // Inputs of process
                input[0] = ['h37rv_100k', file("test_data/h37rv_100k/h37rv_100k_1.fastq.gz"), file("test_data/h37rv_100k/h37rv_100k_2.fastq.gz")]
                input[1] = file('test_data/example_output/h37rv_100k_lc_report.json')
                """
            }
        }

        then {
            // Check process has run OK
            assert process.success
            // Check outputs are right
            assert process.out.mykrobe_report.get(0).contains('h37rv_100k_mykrobe_report.json')
            assert path(process.out.mykrobe_report.get(0)).json == path('./test_data/example_output/h37rv_100k_mykrobe_report.json').json
        }
    }
}
