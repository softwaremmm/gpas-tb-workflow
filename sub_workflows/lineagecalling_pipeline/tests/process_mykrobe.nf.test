nextflow_process {
    name 'Test Process mykrobe'
    script 'main.nf'
    process 'mykrobe'

    test('Regression test against expected outputs (absc_100k)') {
        when {
            process {
                """
                // Inputs of process
                input[0] = ['absc_100k', file("test_data/absc_100k/absc_100k_1.fastq.gz"), file("test_data/absc_100k/absc_100k_2.fastq.gz")]
                """
            }
        }

        then {
            // Check process has run OK
            assert process.success
            // Check outputs are right
            assert process.out.report.get(0).contains('absc_100k_lc_report.json')
            assert path(process.out.report.get(0)).json == path('./test_data/example_output/absc_100k_lc_report.json').json
        }
    }

    test('Regression test against expected outputs (h37rv_100k)') {
        when {
            process {
                """
                // Inputs of process
                input[0] = ['h37rv_100k', file("test_data/h37rv_100k/h37rv_100k_1.fastq.gz"), file("test_data/h37rv_100k/h37rv_100k_2.fastq.gz")]
                """
            }
        }

        then {
            // Check process has run OK
            assert process.success
            // Check outputs are right
            assert process.out.report.get(0).contains('h37rv_100k_lc_report.json')
            assert path(process.out.report.get(0)).json == path('./test_data/example_output/h37rv_100k_lc_report.json').json
        }
    }

    test('Specifying non-existant files as input causes fatal error') {
        when {
            process {
                """
                input[0] = ['no_data', file("test_data_is_not_here"), file("test_data_is_not_here_either")]
                """
            }
        }

        then {
            assert process.errorReport.contains('Fatal Error: Cannot open')
        }
    }
}
