nextflow_workflow {

    name "Test Workflow"
    script "main.nf"
    workflow "gatekeeper"

    test("Should succeed producing the gatekeeper output files") {

        when {

            params {
                input_dir = "tests/samples/local/"
                kraken2_db_path = [file("/mnt/volume_data/datasets_full/standard_05-06-2023")]
            }
              
            workflow {
                """
                input[0] = ['sample_test', file("tests/nextflow/samples/clinic/test_clinic_sample_1.fastq.gz"), file("tests/nextflow/samples/clinic/test_clinic_sample_2.fastq.gz")]
                input[1] = [file("/mnt/volume_data/datasets_full/standard_05-06-2023")]
                """
            }

        }

        then {

            assert workflow.success



            with(workflow.out.fastp_report) {
                assert get(0).contains("fastp_report.json")
            }

            with(workflow.out.fastp_error) {
                assert get(0).contains("fastp_error.json")
            }


            with(workflow.out.kraken2_filtered_samples) {

                assert get(0)[0].contains("sample_test")
                assert get(0)[1].contains("kraken2_filtered_1.fastq.gz")
                assert get(0)[2].contains("kraken2_filtered_2.fastq.gz")
            }

            with(workflow.out.kraken2_outputs) {

                assert get(0)[0].contains("sample_test")
                assert get(0)[1].contains("kraken_report.txt")
                assert get(0)[2].contains("kraken_json.json")
            }

            with(workflow.out.gatekeeper_report) {
                assert get(0).contains("gatekeeper_report.json")
            }


            assert workflow.out.kraken2_enough_reads[0] == "true"
            
        }

    }

}
