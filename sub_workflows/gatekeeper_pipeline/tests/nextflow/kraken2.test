nextflow_process {

    name "Test Process Kraken2"
    script "process/kraken2.nf"
    process "kraken2"


    test("kraken2 classification should succeed when sample name and paths to fastq files are provided") {

        when {
            process{
                """
                input[0] = ['sample_test', file("tests/nextflow/samples/clinic/test_clinic_sample_1.fastq.gz"), file("tests/nextflow/samples/clinic/test_clinic_sample_2.fastq.gz")]
                input[1] = [file("/mnt/volume_data/datasets_full/standard_05-06-2023")]
                input[2] = 20000
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            assert process.exitStatus == 0
            assert process.out[0][0][0] == "sample_test"
            assert process.out[0][0][1].contains("kraken_report.txt")
            assert process.out[0][0][2].contains("kraken_json.json")
        }

    }

    test("Process should generate a report with the number of reads of the relevant keys of Kraken2") {

        when {

            process{
                """
                input[0] = ['sample_test', file("tests/nextflow/samples/clinic/test_clinic_sample_1.fastq.gz"), file("tests/nextflow/samples/clinic/test_clinic_sample_2.fastq.gz")]
                input[1] = [file("/mnt/volume_data/datasets_full/standard_05-06-2023")]
                input[2] = 20000
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            assert process.exitStatus == 0
            assert process.out[0][0][0] == "sample_test"
            assert process.out[2][0].contains("gatekeeper_report.json")
            assert path(process.out[2][0]).json.get("unclassified").toInteger() >= 0
            assert path(process.out[2][0]).json.get("classified").toInteger() >= 0
            assert path(process.out[2][0]).json.get("Bacteria").toInteger() >= 0
            assert path(process.out[2][0]).json.get("Mycobacteriaceae").toInteger() >= 0
            assert path(process.out[2][0]).json.get("Homo sapiens").toInteger() >= 0
        }

    }


    test("Process should generate not empty files for the filtered version if the number of unclassified and Mycobacteriaceae reads is bigger or equal than specified") {

        when {

            process{
                """
                input[0] = ['sample_test', file("tests/nextflow/samples/clinic/test_clinic_sample_1.fastq.gz"), file("tests/nextflow/samples/clinic/test_clinic_sample_2.fastq.gz")]
                input[1] = [file("/mnt/volume_data/datasets_full/standard_05-06-2023")]
                input[2] = 20000
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            assert process.exitStatus == 0
            assert process.out[0][0][0] == "sample_test"
            assert process.out[2][0].contains("gatekeeper_report.json")
            
            assert process.out[1][0][1].contains("kraken2_filtered_1.fastq")
            assert process.out[1][0][2].contains("kraken2_filtered_2.fastq")

            assert file(process.out[1][0][1]).size() > 0
            assert file(process.out[1][0][2]).size() > 0

        }

    }

    test("Process should generate empty files for the filtered version if the number of unclassified and Mycobacteriaceae reads is smaller than specified") {

        when {

            process{
                """
                input[0] = ['sample_test', file("tests/nextflow/samples/default_samples/illumina-sample_1.fastq.gz"), file("tests/nextflow/samples/default_samples/illumina-sample_test_kraken2_filtered_2.fastq.gz")]
                input[1] = [file("/mnt/volume_data/datasets_full/standard_05-06-2023")]
                input[2] = 20000
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            assert process.exitStatus == 0
            assert process.out[0][0][0] == "sample_test"
            assert process.out[2][0].contains("gatekeeper_report.json")

            assert process.out[1][0][1].contains("kraken2_filtered_1.fastq")
            assert process.out[1][0][2].contains("kraken2_filtered_2.fastq")

            assert process.out[3][0].contains("kraken_error.json")


            assert file(process.out[1][0][1]).size() == 0
            assert file(process.out[1][0][2]).size() == 0
        }

    }

    test("Error report should have information about not enough reads if the number of unclassified and Mycobacteriaceae reads is smaller than specified") {

        when {

            process{
                """
                input[0] = ['sample_test', file("tests/nextflow/samples/default_samples/illumina-sample_1.fastq.gz"), file("tests/nextflow/samples/default_samples/illumina-sample_test_kraken2_filtered_2.fastq.gz")]
                input[1] = [file("/mnt/volume_data/datasets_full/standard_05-06-2023")]
                input[2] = 20000
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            assert process.exitStatus == 0
            assert process.out[0][0][0] == "sample_test"

            with(process.out.kraken2_log) {
                assert size() == 1
                assert get(0).contains("kraken_error.json")
                assert path(get(0)).json[0].get("num_reads_error") == "Not enough reads"
            }
        }

    }

}
