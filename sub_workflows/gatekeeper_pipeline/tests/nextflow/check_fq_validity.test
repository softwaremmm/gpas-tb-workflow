nextflow_process {

    name "Test Process checkFqValidity"
    script "process/quality_check.nf"
    process "checkFqValidity"

    test("Should successed when sample name and paths to fastq files are provided") {

        when {
            params {
                output_dir = "tests/results"
            }

            process{
                """
                input[0] = ['sample_test', file("tests/samples/illumina-sample_1.fastq.gz"), file("tests/samples/illumina-sample_2.fastq.gz")]
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            assert process.exitStatus == 0
        }

    }

    


}